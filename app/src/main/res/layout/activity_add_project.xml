<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".EditProjectActivity">

    <EditText
        android:id="@+id/repoUrlEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Repository URL"
        android:text=""
        />

    <EditText
        android:id="@+id/userNameEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:hint="username" />

    <EditText
        android:id="@+id/passwordEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:inputType="textPassword"
        android:hint="password" />

    <Button
        android:id="@+id/buttonSaveProject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Project" />

    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Test Folder"
        android:visibility="gone"
        />




</LinearLayout>